# Use the bare resource endpoint, NOT the Foundry project endpoint
# (i.e. no /api/projects/<name> suffix) — the project-scoped URL 404s/
# rejects the api-version against the openai SDK's AzureOpenAI client.
AZURE_AI_ENDPOINT=https://[our-resource].services.ai.azure.com/
AZURE_AI_API_KEY=
# Fast/cheap model for dev. Swap to AZURE_AI_DEPLOYMENT_PROD's value (gpt-5.1) for production/demo.
AZURE_AI_DEPLOYMENT=gpt-5.4-mini
AZURE_AI_DEPLOYMENT_PROD=gpt-5.1
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_AI_API_VERSION=2025-04-01-preview

# Use the service_role key here (not the frontend's publishable key) —
# the backend needs to bypass RLS to write across all tables.
SUPABASE_URL=
SUPABASE_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
